OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini
POSTGRES_USER=coach
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=career_coach
# URL-encode special characters in the password when setting DATABASE_URL.
DATABASE_URL=postgresql://coach:replace-with-a-local-password@localhost:5433/career_coach
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_USER_ID=replace-with-your-numeric-user-id
COACH_DEMO=false
